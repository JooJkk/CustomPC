<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.CatalogoController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="Catálogo de Componentes">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <TableView fx:id="tabelaComponentes" prefHeight="400.0" prefWidth="600.0">
            <columns>
                <TableColumn fx:id="colunaNome" prefWidth="250.0" text="Produto" />
                <TableColumn fx:id="colunaMarca" prefWidth="150.0" text="Marca" />
                <TableColumn fx:id="colunaPreco" prefWidth="150.0" text="Preço (R$)" />
            </columns>
        </TableView>

        <Button fx:id="btnAdicionar" mnemonicParsing="false" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;" text="Adicionar ao Carrinho">
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
            </padding>
        </Button>
    </children>
</VBox>
