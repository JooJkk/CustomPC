<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.CatalogoController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="Catálogo de Peças">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <TableView fx:id="tabelaComponentes" prefHeight="400.0" prefWidth="600.0">
            <columns>
                <TableColumn fx:id="colunaNome" prefWidth="250.0" text="Produto" />
                <TableColumn fx:id="colunaMarca" prefWidth="150.0" text="Marca" />
                <TableColumn fx:id="colunaPreco" prefWidth="150.0" text="Preço (R$)" />
            </columns>
        </TableView>

        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Button fx:id="btnVoltar" mnemonicParsing="false" onAction="#voltarHome" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" text="Voltar para Menu" />
                <Button fx:id="btnAdicionar" mnemonicParsing="false" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;" text="Adicionar" />
                <Button fx:id="btnEnviarBuild" mnemonicParsing="false" onAction="#enviarParaBuild" style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-weight: bold;" text="Levar para o Build 🛠️" />
                <Button fx:id="btnIrCarrinho" mnemonicParsing="false" onAction="#irParaCarrinho" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;" text="Ver Carrinho 🛒" />
            </children>
        </HBox>
    </children>
</VBox>