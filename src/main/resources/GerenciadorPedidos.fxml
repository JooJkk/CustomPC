<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.Cursor?>

<VBox alignment="CENTER" prefHeight="800.0" prefWidth="1200.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.GerenciadorPedidosController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <Label text="PAINEL DE GERENCIAMENTO DE PEDIDOS (ADMIN)">
        <font>
            <Font name="System Bold" size="22.0" />
        </font>
    </Label>

    <ScrollPane fitToWidth="true" prefHeight="550.0" prefWidth="1140.0">
        <content>
            <VBox fx:id="containerPedidos" spacing="15.0" style="-fx-padding: 15; -fx-background-color: #f4f4f4;">
            </VBox>
        </content>
    </ScrollPane>

    <Button mnemonicParsing="false" onAction="#onBotaoVoltarClick" prefHeight="35.0" style="-fx-background-color: #7d7d7d; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold;" text="Voltar para Menu Admin 🛠️">
        <font>
            <Font size="14.0" />
        </font>
        <cursor>
            <Cursor fx:constant="HAND" />
        </cursor>
    </Button>
</VBox>