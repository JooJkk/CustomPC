<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.Cursor?>
<VBox alignment="CENTER" prefHeight="800.0" prefWidth="1200.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.PedidoController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <Label text="MEUS PEDIDOS">
        <font>
            <Font name="System Bold" size="20.0" />
        </font>
    </Label>

    <ScrollPane fitToWidth="true" prefHeight="400.0" prefWidth="400.0">
        <content>
            <VBox fx:id="containerPedidos" spacing="15.0" style="-fx-padding: 10;">
            </VBox>
        </content>
    </ScrollPane>

    <Button mnemonicParsing="false" onAction="#onBotaoVoltarClick" prefHeight="30.0" style="-fx-background-color: #1e90ff; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold;" text="Voltar para Área do Cliente 👤">
        <font>
            <Font size="14.0" />
        </font>
        <cursor>
            <Cursor fx:constant="HAND" />
        </cursor>
    </Button>
</VBox>
