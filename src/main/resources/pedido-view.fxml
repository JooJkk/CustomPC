<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.PedidoController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
    <children>
        <Label text="ACOMPANHAMENTO DO PEDIDO">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <Label fx:id="lblNumeroPedido" text="Número do Pedido: --">
            <font>
                <Font size="16.0" />
            </font>
        </Label>
        <Label fx:id="lblDataPedido" text="Data do Pedido: --">
            <font>
                <Font size="14.0" />
            </font>
        </Label>
        <Label fx:id="lblTotalPedido" text="Valor Total: R$ 0,00">
            <font>
                <Font size="16.0" />
            </font>
        </Label>
        <Label fx:id="lblStatusPedido" text="Status: Aguardando..." textFill="#2ecc71">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>

        <ProgressBar fx:id="barraProgresso" prefWidth="300.0" progress="0.25" />

        <Button text="Voltar para a Área do Cliente" onAction="#onBotaoVoltarClick" style="-fx-padding: 8 15 8 15;" />
    </children>
</VBox>