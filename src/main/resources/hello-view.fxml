<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="800.0" prefWidth="1200.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.ClienteController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label fx:id="lblBoasVindas" text="SEJA BEM-VINDO(A)!" textAlignment="CENTER" wrapText="true">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <Label text="Utilize o menu lateral para navegar pelo sistema da loja." textFill="#7f8c8d">
            <font>
                <Font size="14.0" />
            </font>
        </Label>
    </children>
</VBox>
