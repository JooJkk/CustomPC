<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="800.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.LoginController">

    <!-- Barra superior igual às outras telas -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="15.0"
              style="-fx-background-color: #2c3e50; -fx-border-color: #1e90ff; -fx-border-width: 0 0 2 0;"
              BorderPane.alignment="CENTER">
            <padding>
                <Insets left="20.0" right="20.0" />
            </padding>
            <children>
                <Label text="CustomPC 🖥️" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="32.0" />
                    </font>
                </Label>
                <HBox HBox.hgrow="ALWAYS" />
                <Button onAction="#irParaHome" prefHeight="35.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #aaaaaa; -fx-font-size: 13;"
                        text="← Voltar">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>
            </children>
        </HBox>
    </top>

    <!-- Formulário centralizado -->
    <center>
        <VBox alignment="CENTER" spacing="0" style="-fx-background-color: #f4f6f9;" BorderPane.alignment="CENTER">

            <VBox alignment="CENTER" spacing="20.0"
                  style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 16, 0, 0, 4);"
                  maxWidth="420.0">
                <padding>
                    <Insets top="45.0" bottom="45.0" left="50.0" right="50.0" />
                </padding>

                <!-- Título -->
                <Label text="Entrar na sua conta" textFill="#2c3e50">
                    <font>
                        <Font name="System Bold" size="26.0" />
                    </font>
                </Label>

                <Label text="Acesse o catálogo, pedidos e carrinho." textFill="#7f8c8d">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>

                <!-- Campo Email -->
                <VBox spacing="6.0" maxWidth="320.0">
                    <Label text="E-mail" textFill="#2c3e50">
                        <font>
                            <Font name="System Bold" size="13.0" />
                        </font>
                    </Label>
                    <TextField fx:id="campoEmail" promptText="seu@email.com"
                               prefHeight="42.0"
                               style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #dce1e7; -fx-border-width: 1.5; -fx-font-size: 14; -fx-padding: 0 12 0 12;" />
                </VBox>

                <!-- Campo Senha -->
                <VBox spacing="6.0" maxWidth="320.0">
                    <Label text="Senha" textFill="#2c3e50">
                        <font>
                            <Font name="System Bold" size="13.0" />
                        </font>
                    </Label>
                    <PasswordField fx:id="campoSenha" promptText="••••••••"
                                  prefHeight="42.0"
                                  style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #dce1e7; -fx-border-width: 1.5; -fx-font-size: 14; -fx-padding: 0 12 0 12;" />
                </VBox>

                <!-- Mensagem de erro -->
                <Label fx:id="lblErro" text="" textFill="#e74c3c" wrapText="true" maxWidth="320.0">
                    <font>
                        <Font size="13.0" />
                    </font>
                </Label>

                <!-- Botão Entrar -->
                <Button fx:id="btnEntrar" onAction="#fazerLogin"
                        prefHeight="44.0" prefWidth="320.0"
                        style="-fx-background-color: #1e90ff; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-weight: bold; -fx-font-size: 15;"
                        text="Entrar 🔑">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

                <!-- Divisor -->
                <HBox alignment="CENTER" spacing="10.0" maxWidth="320.0">
                    <HBox style="-fx-background-color: #dce1e7; -fx-min-height: 1;" HBox.hgrow="ALWAYS" />
                    <Label text="ou" textFill="#aaaaaa">
                        <font><Font size="12.0" /></font>
                    </Label>
                    <HBox style="-fx-background-color: #dce1e7; -fx-min-height: 1;" HBox.hgrow="ALWAYS" />
                </HBox>

                <!-- Botão Cadastrar -->
                <Button onAction="#irParaCadastro"
                        prefHeight="44.0" prefWidth="320.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #1e90ff; -fx-background-radius: 10; -fx-font-weight: bold; -fx-font-size: 14; -fx-border-color: #1e90ff; -fx-border-radius: 10; -fx-border-width: 1.5;"
                        text="Criar nova conta">
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>

            </VBox>
        </VBox>
    </center>

</BorderPane>
