<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="650.0" prefWidth="800.0" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.BuildsController">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <Label text="Monte seu CustomPC">
        <font>
            <Font name="System Bold" size="28.0" />
        </font>
        <VBox.margin>
            <Insets bottom="20.0" />
        </VBox.margin>
    </Label>

    <Label text="Escolha o Processador:" />
    <ComboBox fx:id="comboProcessador" prefWidth="400.0" promptText="Selecione um Processador..." />

    <Label text="Escolha a Placa-Mãe:" />
    <ComboBox fx:id="comboPlacaMae" prefWidth="400.0" promptText="Selecione uma Placa-Mãe..." />

    <Label text="Escolha a Memória RAM:" />
    <ComboBox fx:id="comboRam" prefWidth="400.0" promptText="Selecione a Memória RAM..." />

    <Label text="Escolha a Fonte de Alimentação:" />
    <ComboBox fx:id="comboFonte" prefWidth="400.0" promptText="Selecione uma Fonte..." />

    <Label fx:id="lblResultado" text="Selecione os componentes e clique em Validar." textFill="#7f8c8d">
        <font>
            <Font size="14.0" />
        </font>
        <VBox.margin>
            <Insets bottom="10.0" top="10.0" />
        </VBox.margin>
    </Label>

    <Button mnemonicParsing="false" onAction="#validarBuild" prefWidth="400.0" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Validar Build">
        <font>
            <Font size="14.0" />
        </font>
    </Button>

    <Button mnemonicParsing="false" onAction="#limparBancada" prefWidth="400.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Limpar Bancada" />

    <HBox alignment="CENTER" spacing="15.0">
        <VBox.margin>
            <Insets top="15.0" />
        </VBox.margin>
        <children>
            <Button mnemonicParsing="false" onAction="#voltarCatalogo" prefWidth="192.0" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="⬅ Voltar ao Catálogo" />
            <Button mnemonicParsing="false" onAction="#voltarHome" prefWidth="192.0" style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="🏠 Menu Principal" />
        </children>
    </HBox>
</VBox>