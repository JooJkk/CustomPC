<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="800.0" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.BuildsController">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <Label text="Monte seu CustomPC">
        <font>
            <Font name="System Bold" size="28.0" />
        </font>
        <VBox.margin>
            <Insets bottom="20.0" />
        </VBox.margin>
    </Label>

    <Label text="Escolha o Processador:" />
    <ComboBox fx:id="comboProcessador" prefWidth="400.0" promptText="Selecione um Processador..." />

    <Label text="Escolha a Placa-Mãe:" />
    <ComboBox fx:id="comboPlacaMae" prefWidth="400.0" promptText="Selecione uma Placa-Mãe..." />

    <Label text="Escolha a Memória RAM:" />
    <ComboBox fx:id="comboRam" prefWidth="400.0" promptText="Selecione a Memória RAM..." />

    <Label text="Escolha a Fonte de Alimentação:" />
    <ComboBox fx:id="comboFonte" prefWidth="400.0" promptText="Selecione uma Fonte..." />

    <Label fx:id="lblResultado" textAlignment="CENTER" wrapText="true">
        <VBox.margin>
            <Insets top="20.0" bottom="10.0" />
        </VBox.margin>
        <font>
            <Font size="14.0" />
        </font>
    </Label>

    <Button onAction="#validarBuild" style="-fx-background-color: #1e90ff; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20 10 20;" text="Verificar Compatibilidade" />

</VBox>