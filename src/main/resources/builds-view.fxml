<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="800.0" prefWidth="1200.0" spacing="12.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.BuildsController">
    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>

    <Label text="Monte seu CustomPC 🛠️" textFill="#2c3e50">
        <font>
            <Font name="System Bold" size="32.0" />
        </font>
        <VBox.margin>
            <Insets bottom="10.0" />
        </VBox.margin>
    </Label>

    <Label style="-fx-font-weight: bold; -fx-font-size: 13;" text="Escolha o Processador:" textFill="#34495e" />
    <ComboBox fx:id="comboProcessador" prefHeight="35.0" prefWidth="400.0" promptText="Selecione um Processador..." style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e2e8f0;" />

    <Label style="-fx-font-weight: bold; -fx-font-size: 13;" text="Escolha a Placa-Mãe:" textFill="#34495e" />
    <ComboBox fx:id="comboPlacaMae" prefHeight="35.0" prefWidth="400.0" promptText="Aguardando Processador..." style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e2e8f0;" />

    <Label style="-fx-font-weight: bold; -fx-font-size: 13;" text="Escolha a Memória RAM:" textFill="#34495e" />
    <ComboBox fx:id="comboRam" prefHeight="35.0" prefWidth="400.0" promptText="Aguardando Placa-Mãe..." style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e2e8f0;" />

    <Label style="-fx-font-weight: bold; -fx-font-size: 13;" text="Escolha a Placa de Vídeo (GPU):" textFill="#34495e" />
    <ComboBox fx:id="comboPlacaVideo" prefHeight="35.0" prefWidth="400.0" promptText="Aguardando Memória RAM..." style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e2e8f0;" />

    <Label style="-fx-font-weight: bold; -fx-font-size: 13;" text="Escolha o Gabinete:" textFill="#34495e" />
    <ComboBox fx:id="comboGabinete" prefHeight="35.0" prefWidth="400.0" promptText="Aguardando Placa de Vídeo..." style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e2e8f0;" />

    <Label style="-fx-font-weight: bold; -fx-font-size: 13;" text="Escolha a Fonte de Alimentação:" textFill="#34495e" />
    <ComboBox fx:id="comboFonte" prefHeight="35.0" prefWidth="400.0" promptText="Aguardando Gabinete..." style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e2e8f0;" />

    <Label fx:id="lblResultado" text="Escolha um Processador para iniciar a montagem da Build." textAlignment="CENTER" textFill="#1e90ff" wrapText="true">
        <font>
            <Font name="System Bold" size="14.0" />
        </font>
        <VBox.margin>
            <Insets bottom="10.0" top="10.0" />
        </VBox.margin>
    </Label>

    <Button mnemonicParsing="false" onAction="#adicionarEIrParaCarrinho" prefHeight="40.0" prefWidth="400.0" style="-fx-background-color: #1e90ff; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" text="🛒 Enviar peças ao Carrinho">
        <font>
            <Font size="14.0" />
        </font>
        <cursor>
            <Cursor fx:constant="HAND" />
        </cursor>
    </Button>

    <Button mnemonicParsing="false" onAction="#limparBancada" prefHeight="35.0" prefWidth="400.0" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" text="Limpar Bancada 🧹">
        <cursor>
            <Cursor fx:constant="HAND" />
        </cursor>
        <VBox.margin>
            <Insets bottom="10.0" />
        </VBox.margin>
    </Button>

    <HBox alignment="CENTER" maxHeight="800.0" maxWidth="1200.0" spacing="16.0">
        <children>
            <Button mnemonicParsing="false" onAction="#voltarCatalogo" prefHeight="40.0" prefWidth="192.0" style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" text="⬅ Voltar ao Catálogo">
                <cursor>
                    <Cursor fx:constant="HAND" />
                </cursor>
            </Button>
            <Button mnemonicParsing="false" onAction="#voltarHome" prefHeight="40.0" prefWidth="192.0" style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" text="🏠 Menu Principal">
                <cursor>
                    <Cursor fx:constant="HAND" />
                </cursor>
            </Button>
        </children>
    </HBox>
</VBox>
